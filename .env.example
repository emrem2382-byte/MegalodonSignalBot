# Copy this file to .env for LOCAL testing only — never commit the real .env.
# In GitHub Actions, set these as repo secrets instead:
# Settings -> Secrets and variables -> Actions -> New repository secret

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=123456789

# How many indicators (out of all registered) must say BUY, AND outnumber
# any SELL votes, before a signal fires. Backtested default: 3.
MIN_BUY_VOTES=3

# yfinance history window used for indicator calculations.
# 5y so daily EMA200 and the FIA indicator's weekly higher-timeframe EMA200
# (needs ~200 weeks) both have enough bars.
LOOKBACK_PERIOD=5y
LOOKBACK_INTERVAL=1d
